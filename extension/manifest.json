{
  "manifest_version": 3,
  "name": "Context: Insert context",
  "short_name": "Context",
  "version": "0.12.0",
  "description": "Puts the sources you tagged in the Context Mac app into the ChatGPT message box, at the caret, when you ask. It never sends a message.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Insert context", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "commands": { "_execute_action": { "description": "Insert context at the caret" } },
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [{ "matches": ["https://chatgpt.com/*"], "js": ["lib.js", "composer.js"], "run_at": "document_idle", "all_frames": false }]
}
